# Normalize line endings in the repository. The working tree is checked out
# with LF everywhere so scripts, Markdown, and fixtures are reproducible across
# Windows, macOS, and Linux.
* text=auto eol=lf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
